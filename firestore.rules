rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.keys().hasAll(['uid', 'email']) &&
             data.email is string && data.email.size() <= 200;
    }

    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && userId == request.auth.uid;
      allow create: if isVerified() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isVerified() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'city', 'lastLoginDate', 'streakDays']);
    }

    match /trees/{treeId} {
      // Allow reading available trees or trees owned by the user
      allow list: if isVerified() && (resource.data.status == 'available' || resource.data.currentOwnerId == request.auth.uid || request.auth.uid in resource.data.sharedWith);
      allow get: if isVerified() && isValidId(treeId) && (resource.data.status == 'available' || resource.data.currentOwnerId == request.auth.uid || request.auth.uid in resource.data.sharedWith);
      
      // For simplified renting logic client-side:
      allow update: if isVerified() && isValidId(treeId) && 
                    existing().status == 'available' && 
                    incoming().status == 'rented_user' && 
                    incoming().currentOwnerId == request.auth.uid &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'currentOwnerId']);
    }

    match /subscriptions/{subId} {
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow get: if isVerified() && isValidId(subId) && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(subId) && incoming().userId == request.auth.uid && incoming().keys().hasAll(['userId', 'treeId']);
    }

    match /dailyUpdates/{updateId} {
      // Find parent tree owner bypass - complex, prefer client looking at treeId
      allow get: if isVerified() && isValidId(updateId);
      allow list: if isVerified() && resource.data.treeId is string;
    }

    match /posts/{postId} {
      allow read: if isVerified();
      allow create: if isVerified() && isValidId(postId) && incoming().userId == request.auth.uid && incoming().keys().hasAll(['userId', 'imageUrl']);
    }
    
    // Server-only tables (written via Admin SDK / Cloud Functions): Deliveries, CarbonLogs, Referrals, etc.
  }
}
